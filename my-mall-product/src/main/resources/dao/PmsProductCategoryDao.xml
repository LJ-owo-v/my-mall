<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.mymall.product.dao.PmsProductCategoryDao" >
    <resultMap id="listWithChildrenMap" type="com.mymall.product.domain.PmsProductCategoryWithChildrenItem"
               extends="com.mymall.product.dao.PmsProductCategoryMapper.BaseResultMap">
        <collection property="children" resultMap="com.mymall.product.dao.PmsProductCategoryMapper.BaseResultMap"
                    columnPrefix="child_"></collection>
    </resultMap>

    <!-- 一级分类 + 其子分类：c1 是父，c2 是子（自连接 on c1.id = c2.parent_id）
         注意：resultMap 的 columnPrefix="child_"，所以子分类字段必须别名成 child_xxx，
         否则子对象字段全是 null（原实现即如此）。 -->
    <select id="listWithChildren" resultMap="listWithChildrenMap">
        select
            c1.id,
            c1.name,
            c2.id   child_id,
            c2.name child_name
        from pms_product_category c1 left join pms_product_category c2 on c1.id = c2.parent_id
        where c1.parent_id = 0
    </select>
</mapper>