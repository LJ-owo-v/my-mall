<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">
<!--
  MyBatis Generator 配置 —— 只生成本域的表（数据私有）
  ★ 必须在模块目录里执行： cd my-mall-<域>  →  mvn mybatis-generator:generate
  生成：model → src/main/java/com/mymall/order/model
        Mapper → src/main/java/com/mymall/order/dao
        XML    → src/main/resources/dao
-->
<generatorConfiguration>
    <context id="MySqlContext" targetRuntime="MyBatis3" defaultModelType="flat">
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>
        <property name="javaFileEncoding" value="UTF-8"/>

        <plugin type="org.mybatis.generator.plugins.SerializablePlugin"/>
        <plugin type="org.mybatis.generator.plugins.ToStringPlugin"/>
        <plugin type="org.mybatis.generator.plugins.UnmergeableXmlMappersPlugin"/>

        <commentGenerator>
            <property name="suppressAllComments" value="false"/>
            <property name="suppressDate" value="true"/>
            <property name="addRemarkComments" value="true"/>
        </commentGenerator>

        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="jdbc:mysql://localhost:3306/mall?useUnicode=true&amp;characterEncoding=utf-8&amp;serverTimezone=Asia/Shanghai&amp;useSSL=false&amp;allowPublicKeyRetrieval=true"
                        userId="root"
                        password="123456">
            <property name="nullCatalogMeansCurrent" value="true"/>
        </jdbcConnection>

        <javaTypeResolver>
            <property name="forceBigDecimals" value="false"/>
        </javaTypeResolver>

        <javaModelGenerator targetPackage="com.mymall.order.model" targetProject="src/main/java">
            <property name="enableSubPackages" value="false"/>
            <!-- ★ 必须 false：true 会生成 trim 的 setter，静默吃掉库里字段的尾空格（D6 实测） -->
            <property name="trimStrings" value="false"/>
        </javaModelGenerator>

        <sqlMapGenerator targetPackage="dao" targetProject="src/main/resources">
            <property name="enableSubPackages" value="false"/>
        </sqlMapGenerator>

        <javaClientGenerator type="XMLMAPPER" targetPackage="com.mymall.order.dao" targetProject="src/main/java">
            <property name="enableSubPackages" value="false"/>
        </javaClientGenerator>
        <table tableName="oms_order" domainObjectName="OmsOrder"><generatedKey column="id" sqlStatement="MySql" identity="true"/></table>
        <table tableName="oms_order_item" domainObjectName="OmsOrderItem"><generatedKey column="id" sqlStatement="MySql" identity="true"/></table>
        <table tableName="oms_order_operate_history" domainObjectName="OmsOrderOperateHistory"><generatedKey column="id" sqlStatement="MySql" identity="true"/></table>
        <table tableName="oms_order_return_apply" domainObjectName="OmsOrderReturnApply"><generatedKey column="id" sqlStatement="MySql" identity="true"/></table>
        <table tableName="oms_order_return_reason" domainObjectName="OmsOrderReturnReason"><generatedKey column="id" sqlStatement="MySql" identity="true"/></table>
        <table tableName="oms_order_setting" domainObjectName="OmsOrderSetting"><generatedKey column="id" sqlStatement="MySql" identity="true"/></table>
        <table tableName="oms_company_address" domainObjectName="OmsCompanyAddress"><generatedKey column="id" sqlStatement="MySql" identity="true"/></table>
    </context>
</generatorConfiguration>